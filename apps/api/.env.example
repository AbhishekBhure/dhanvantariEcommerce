# ================================================================
# DHANVANTARI API — Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control
# ================================================================

# ─── Server ──────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ─── Database (Supabase PostgreSQL) ──────────────────────────
# Get from: Supabase Dashboard → Settings → Database → Connection string
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# ─── Authentication ───────────────────────────────────────────
JWT_SECRET="replace-with-a-very-long-random-secret-key-minimum-64-chars"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# ─── Supabase Storage (for product images) ───────────────────
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_KEY="your-supabase-service-role-key"

# ─── Razorpay (Test Mode) ─────────────────────────────────────
# Get from: Razorpay Dashboard → Settings → API Keys
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your-razorpay-test-secret"
RAZORPAY_WEBHOOK_SECRET="your-razorpay-webhook-secret"

# ─── Resend (Email) ───────────────────────────────────────────
# Get from: resend.com → API Keys
RESEND_API_KEY="re_xxxxxxxxxxxx"
RESEND_FROM_EMAIL="noreply@dhanvantari.in"
RESEND_FROM_NAME="Dhanvantari Ayurvedic Agencies"

# ─── Shiprocket (Shipping) ────────────────────────────────────
# Get from: Shiprocket Dashboard → Settings → API
SHIPROCKET_EMAIL="your-shiprocket-email"
SHIPROCKET_PASSWORD="your-shiprocket-password"

# ─── Frontend URLs ────────────────────────────────────────────
STOREFRONT_URL="http://localhost:3000,https://your-storefront.vercel.app"
ADMIN_URL="http://localhost:3001,https://your-admin.vercel.app"

# ─── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
