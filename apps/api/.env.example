# ================================================================
# DHANVANTARI API — Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control
# ================================================================

# ─── Server ──────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ─── Database (Supabase PostgreSQL) ──────────────────────────
# Get from: Supabase Dashboard → Settings → Database → Connection string
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# ─── Authentication ───────────────────────────────────────────
JWT_SECRET="replace-with-a-very-long-random-secret-key-minimum-64-chars"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"
OTP_HMAC_SECRET="replace-with-a-separate-long-random-secret"

# ─── Twilio SMS (phone verification) ─────────────────────────
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_FROM_NUMBER="+1xxxxxxxxxx"

# ─── Supabase Storage (for product images) ───────────────────
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_KEY="your-supabase-service-role-key"
SUPABASE_PRODUCT_IMAGES_BUCKET="product-images"

# ─── Razorpay (Test Mode) ─────────────────────────────────────
# Get from: Razorpay Dashboard → Settings → API Keys
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your-razorpay-test-secret"
RAZORPAY_WEBHOOK_SECRET="your-razorpay-webhook-secret"

# ─── Resend (Email) ───────────────────────────────────────────
# Get from: resend.com → API Keys
RESEND_API_KEY="re_xxxxxxxxxxxx"
RESEND_FROM_EMAIL="noreply@dhanvantari.in"
RESEND_FROM_NAME="Dhanvantari Ayurvedic Agencies"

# ─── Shiprocket (Shipping) ────────────────────────────────────
# Get from: Shiprocket Dashboard → Settings → API
SHIPROCKET_EMAIL="your-shiprocket-email"
SHIPROCKET_PASSWORD="your-shiprocket-password"

# ─── India Post (CEPT Business Parcel UAT) ────────────────────
# Set the production CEPT URL only after India Post enables production access
# and whitelists the API server's static outbound IP.
INDIA_POST_API_BASE_URL="https://test.cept.gov.in/beextcustomer"
INDIA_POST_USERNAME="your-india-post-api-username"
INDIA_POST_PASSWORD="your-india-post-api-password"
INDIA_POST_CUSTOMER_ID="your-10-digit-bulk-customer-id"
INDIA_POST_CUSTOM_ID="your-api-booking-custom-id"
INDIA_POST_CONTRACT_ID="your-8-digit-business-parcel-contract-id"
INDIA_POST_SOURCE_OFFICE_ID="your-8-digit-dropoff-office-id"
INDIA_POST_SOURCE_PINCODE="582101"
INDIA_POST_SENDER_NAME="Dhanvantari Ayurvedic Agencies"
INDIA_POST_SENDER_COMPANY="Dhanvantari Ayurvedic Agencies"
INDIA_POST_SENDER_ADDRESS_LINE_1="your-sender-address-line-1"
INDIA_POST_SENDER_ADDRESS_LINE_2=""
INDIA_POST_SENDER_CITY="Gadag"
INDIA_POST_SENDER_STATE="Karnataka"
INDIA_POST_SENDER_PHONE="9741371963"
INDIA_POST_SENDER_EMAIL="shridhanvantariayurvedic@gmail.com"

# ─── Frontend URLs ────────────────────────────────────────────
STOREFRONT_URL="http://localhost:3000,https://your-storefront.vercel.app"
ADMIN_URL="http://localhost:3001,https://your-admin.vercel.app"

# ─── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
